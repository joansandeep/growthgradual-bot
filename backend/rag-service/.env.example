# Paperly RAG Service — environment variables
# Copy to .env for local dev, or set these as Secrets in the Hugging Face Space settings.

# ── Core RAG config (optional — sensible defaults already in rag_engine.py) ──
# EMBED_MODEL=all-MiniLM-L6-v2
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# RELEVANCE_THRESHOLD=0.15
# RAG_PORT=7860

# ── Supabase (OKF bundle persistence) ────────────────────────────────────────
# Same project the main backend already uses for Supabase Storage
# (see backend/.env and backend/routes/chat.py's paperly-uploads bucket).
# Required for OKF concept files (indexed documents stored as markdown with
# YAML frontmatter) to survive a Hugging Face Space restart — the rag-service
# container filesystem itself is ephemeral and is NOT used for OKF storage.
# Without these set, indexing/retrieval (FAISS) still works normally; only
# the durable OKF bundle write/download is skipped (logged once as a warning).
SUPABASE_URL=https://lursidsfebmwjjlebnvk.supabase.co
SUPABASE_ANON_KEY=

# Bucket to store OKF markdown files in (defaults to paperly-uploads, the
# same bucket already used for chat image uploads, under a paperly-okf/ prefix
# so the two don't collide). Override only if you want a dedicated bucket.
# OKF_SUPABASE_BUCKET=paperly-uploads
