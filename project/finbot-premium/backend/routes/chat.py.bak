    "scientificamerican.com", "nature.com", "wikipedia.org",
    "forbes.com", "businessinsider.com", "economist.com",
]

FINANCE_TERMS = [
    "nifty", "sensex", "bse", "nse", "ipo", "rbi", "sebi", "amfi",
    "stock", "share", "equity", "fund", "mutual fund", "nav", "sip",
